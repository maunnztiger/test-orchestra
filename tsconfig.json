{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "paths": {
      "runner": ["./src/runner"],
      "runner/*": ["./src/runner/*"],

      "core/*": ["./src/core/*"],
      "@core/*": ["./src/core/*"],

      "reporting/*": ["./src/reporting/*"],
      "analytics/*": ["./src/analytics/*"],
      "db/*": ["./src/db/*"],

      "scenarios/*": ["./src/scenarios/*"],
      "@scenarios/*": ["./src/scenarios/*"],

      "steps/*": ["./src/steps/*"],
      "@steps/*": ["./src/steps/*"],

      "world/*": ["./src/world/*"],
      "@world/*": ["./src/world/*"],

      "pages/*": ["./src/pages/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist", "tests", "scripts", "playwright.config.ts"]
}
